#!/bin/bash
# REA (Reverse Engineer Anything) CLI in a capped, isolated container; the image is built locally on first use from the
# Dockerfile next to this script (ntjapps/rea-tools; override with REA_TOOLS_DIR).
#   Base image (default): static JavaScript/Electron, .NET, Go, Rust, WASM, SQLite and package inspection.
#   Native image: used automatically for `--provider ghidra` and Android/JADX commands, or with REA_NATIVE=1
#                 (JDK 27 + Ghidra 12.2 + jadx-headless-mcp 0.8.0).
#
# Isolation (audit 2026-11-12, M16): a malicious sample or dependency must not be able to write the repos (and through stack-config
# become root) or read every .env on the box. So the container
#   - runs as a NON-ROOT uid:gid with every capability dropped and no-new-privileges: yours, or when you are root (this host runs
#     everything as root) the fixed unprivileged REA_USER=10001:10001, whose state and output dirs the wrapper chowns. A sample must
#     therefore be readable by that uid (copy it, chmod a+rX);
#   - has NO network (--network none). Opt in per run with REA_NETWORK=1 (or --online as the first argument) for commands that
#     must download something (npm package inspection, live capture you asked for);
#   - sees only the sample paths you pass as arguments, mounted READ-ONLY at the same absolute path (a file or a directory; paths
#     that are relative but start with ./ or ../ are made absolute first), plus ONE writable output directory (REA_OUT, default
#     $REA_STATE/out, mounted at /out, also the working directory) and its own state dir. /home/GitProjects, /home and /tmp are
#     never mounted as a whole (a sample argument that IS one of them, or contains one, is refused): copy the sample into its own
#     directory first. The container's /tmp is a private tmpfs.
#   Pass paths as separate arguments (`rea analyze x /abs/app`, not `--path=/abs/app`): only those are mounted.
#
# Env: REA_MEMORY (default 1500m base, 2g native), REA_CPUS (default 2), REA_NATIVE=1, REA_REBUILD=1, REA_NETWORK=1,
#      REA_OUT (writable output dir), REA_USER (uid:gid when run as root), REA_STATE (REA's home, default ~/.local/share/rea-docker). Any other REA_* variable
#      (e.g. REA_GHIDRA_DISABLED_ANALYZERS) is passed into the container unchanged.
# Check `grep MemAvailable /proc/meminfo` first and run one REA job at a time.
set -euo pipefail
CTX="${REA_TOOLS_DIR:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")}"
[ -f "$CTX/Dockerfile" ] || { echo "rea: no Dockerfile in $CTX (clone ntjapps/rea-tools)" >&2; exit 2; }
VERSION="$(sed -n 's/^ARG REA_VERSION=//p' "$CTX/Dockerfile")"

ONLINE="${REA_NETWORK:-}"
if [ "${1:-}" = "--online" ]; then ONLINE=1; shift; fi

NATIVE="${REA_NATIVE:-}"
if [ -z "$NATIVE" ]; then
    for a in "$@"; do
        case "$a" in ghidra|--provider=ghidra|*android*|*apk*|*jadx*|*dex*) NATIVE=1 ;; esac
    done
fi
if [ -n "$NATIVE" ]; then
    TARGET=native; IMG="local/rea:${VERSION}-native"; MEM="${REA_MEMORY:-2g}"
else
    TARGET=base; IMG="local/rea:${VERSION}"; MEM="${REA_MEMORY:-1500m}"
fi
CPUS="${REA_CPUS:-2}"

if [ -n "${REA_REBUILD:-}" ] || ! docker image inspect "$IMG" >/dev/null 2>&1; then
    # Prefer the image the manual GitHub workflow publishes; build locally when it is absent or REA_REBUILD is set.
    GHCR="ghcr.io/ntjapps/rea-tools:${IMG#local/rea:}"
    if [ -z "${REA_REBUILD:-}" ] && docker pull -q "$GHCR" >/dev/null 2>&1; then
        docker tag "$GHCR" "$IMG"
    else
        echo "rea: building $IMG (target $TARGET) from $CTX" >&2
        docker build --memory=1536m --memory-swap=1536m --target "$TARGET" -t "$IMG" "$CTX" >&2
    fi
fi

STATE="${REA_STATE:-$HOME/.local/share/rea-docker}"
OUT="${REA_OUT:-$STATE/out}"
mkdir -p "$STATE" "$OUT"
chmod 700 "$STATE"
STATE="$(readlink -f "$STATE")"; OUT="$(readlink -f "$OUT")"
RUN_AS="$(id -u):$(id -g)"
if [ "$(id -u)" = 0 ]; then
    RUN_AS="${REA_USER:-10001:10001}"
    chown -R "$RUN_AS" "$STATE" "$OUT"
fi
case "$RUN_AS" in 0|0:*) echo "rea: refusing to run the container as root (REA_USER=$RUN_AS)" >&2; exit 2 ;; esac

# Mount only the sample paths the arguments name, read-only; refuse a whole tree that holds other people's secrets.
refuse() { echo "rea: refusing to mount '$1': $2. Copy the sample into its own directory and pass that." >&2; exit 2; }
ARGS=(); MOUNTS=(); SEEN=" "
for a in "$@"; do
    case "$a" in /*|./*|../*)
        if [ -e "$a" ]; then
            p="$(readlink -f "$a")"
            case "$p" in
                /|/home|/home/GitProjects|/tmp|/root|/etc|/var|/usr|"$HOME") refuse "$p" "that is a whole tree" ;;
            esac
            # a sample path may not contain the output / state dir or any of the protected trees
            for prot in /home/GitProjects /tmp "$HOME"; do
                case "$prot/" in "$p"/*) refuse "$p" "it contains $prot" ;; esac
            done
            case "$p/" in "$STATE"/*|"$OUT"/*) ;; *)
                case "$SEEN" in *" $p "*) ;; *) MOUNTS+=(-v "$p":"$p":ro); SEEN="$SEEN$p " ;; esac ;;
            esac
            a="$p"
        fi ;;
    esac
    ARGS+=("$a")
done

# Pass REA's own settings through; the wrapper's knobs above stay on the host.
ENVS=()
while IFS= read -r v; do
    case "$v" in REA_MEMORY|REA_CPUS|REA_NATIVE|REA_REBUILD|REA_STATE|REA_OUT|REA_USER|REA_NETWORK|REA_TOOLS_DIR) ;; *) ENVS+=(-e "$v") ;; esac
done < <(compgen -e | grep '^REA_' || true)
NET=(--network none)
[ -n "$ONLINE" ] && NET=()
TTY=(-i)
[ -t 0 ] && [ -t 1 ] && TTY=(-it)
exec docker run --rm "${TTY[@]}" --memory="$MEM" --memory-swap="$MEM" --cpus="$CPUS" --pids-limit 1024 \
    --user "$RUN_AS" --cap-drop ALL --security-opt no-new-privileges \
    ${NET[@]+"${NET[@]}"} --tmpfs /tmp:rw,exec,size=1g -e HOME=/state \
    ${ENVS[@]+"${ENVS[@]}"} -v "$STATE":/state -v "$OUT":/out ${MOUNTS[@]+"${MOUNTS[@]}"} -w /out "$IMG" ${ARGS[@]+"${ARGS[@]}"}
